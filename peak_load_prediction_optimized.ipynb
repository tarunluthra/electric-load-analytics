class PeakLoadVisualizer:
    """
    Optimized visualization class for peak load analysis
    """
    
    def __init__(self, figsize: Tuple[int, int] = (15, 10)):
        self.figsize = figsize
        self.colors = {
            'primary': '#FF6B6B',
            'secondary': '#4ECDC4',
            'accent': '#45B7D1',
            'success': '#96CEB4',
            'warning': '#FFEAA7'
        }
    
    def create_comprehensive_dashboard(self, data: pd.DataFrame, predictions: pd.DataFrame = None) -> go.Figure:
        """
        Create an interactive dashboard with all key insights
        """
        fig = make_subplots(
            rows=3, cols=2,
            subplot_titles=[
                '🌅 Daily Peak Load Journey',
                '🌡️ Temperature vs Peak Load',
                '📅 Seasonal Peak Patterns',
                '🏠 Weekend vs Weekday',
                '📊 Load Distribution',
                '🔮 Prediction Confidence'
            ],
            specs=[[{"secondary_y": False}, {"secondary_y": False}],
                   [{"secondary_y": False}, {"secondary_y": False}],
                   [{"secondary_y": False}, {"secondary_y": False}]]
        )
        
        # 1. Daily Peak Journey
        hourly_peaks = data.groupby('Hour')['Is_Peak'].mean()
        fig.add_trace(
            go.Scatter(
                x=hourly_peaks.index,
                y=hourly_peaks.values,
                mode='lines+markers',
                name='Peak Probability',
                line=dict(color=self.colors['primary'], width=3),
                marker=dict(size=8)
            ),
            row=1, col=1
        )
        
        # 2. Temperature Impact
        temp_bins = pd.cut(data['Avg_Temperature'], bins=10)
        temp_peak_rates = data.groupby(temp_bins)['Is_Peak'].mean()
        temp_centers = [interval.mid for interval in temp_peak_rates.index]
        
        fig.add_trace(
            go.Scatter(
                x=temp_centers,
                y=temp_peak_rates.values,
                mode='lines+markers',
                name='Peak Rate by Temperature',
                line=dict(color=self.colors['secondary'], width=3),
                marker=dict(size=8)
            ),
            row=1, col=2
        )
        
        # 3. Seasonal Patterns
        monthly_peaks = data.groupby('Month')['Is_Peak'].mean()
        month_names = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun',
                       'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec']
        
        fig.add_trace(
            go.Bar(
                x=month_names,
                y=monthly_peaks.values,
                name='Monthly Peak Rate',
                marker_color=self.colors['accent']
            ),
            row=2, col=1
        )
        
        # 4. Weekend vs Weekday
        weekend_peaks = data.groupby('IsWeekend')['Is_Peak'].mean()
        fig.add_trace(
            go.Bar(
                x=['Weekday', 'Weekend'],
                y=weekend_peaks.values,
                name='Peak Rate by Day Type',
                marker_color=[self.colors['success'], self.colors['warning']]
            ),
            row=2, col=2
        )
        
        # 5. Load Distribution
        fig.add_trace(
            go.Histogram(
                x=data['Load'],
                nbinsx=50,
                name='Load Distribution',
                marker_color=self.colors['primary'],
                opacity=0.7
            ),
            row=3, col=1
        )
        
        # 6. Prediction Confidence (if available)
        if predictions is not None:
            fig.add_trace(
                go.Histogram(
                    x=predictions['Daily Peak Probability'],
                    nbinsx=30,
                    name='Prediction Confidence',
                    marker_color=self.colors['secondary'],
                    opacity=0.7
                ),
                row=3, col=2
            )
        
        # Update layout
        fig.update_layout(
            title={
                'text': '🏭 Peak Load Analysis Dashboard',
                'x': 0.5,
                'font': {'size': 20, 'color': '#2C3E50'}
            },
            height=1200,
            showlegend=False,
            font=dict(size=12),
            plot_bgcolor='white'
        )
        
        return fig
    
    def plot_model_performance(self, scores: Dict[str, float]) -> go.Figure:
        """
        Plot model performance comparison
        """
        models = list(scores.keys())
        brier_scores = list(scores.values())
        
        # Sort by performance (lower is better)
        sorted_data = sorted(zip(models, brier_scores), key=lambda x: x[1])
        models, brier_scores = zip(*sorted_data)
        
        fig = go.Figure(data=[
            go.Bar(
                x=models,
                y=brier_scores,
                marker_color=[self.colors['primary'] if i == 0 else self.colors['accent'] 
                             for i in range(len(models))],
                text=[f'{score:.4f}' for score in brier_scores],
                textposition='auto'
            )
        ])
        
        fig.update_layout(
            title='🎯 Model Performance Comparison (Lower Brier Score = Better)',
            xaxis_title='Model',
            yaxis_title='Brier Score',
            plot_bgcolor='white',
            height=500
        )
        
        return fig
    
    def plot_feature_importance(self, feature_names: List[str], importances: np.ndarray, top_n: int = 15) -> go.Figure:
        """
        Plot feature importance
        """
        # Sort features by importance
        sorted_idx = np.argsort(importances)[::-1][:top_n]
        top_features = [feature_names[i] for i in sorted_idx]
        top_importances = importances[sorted_idx]
        
        fig = go.Figure(data=[
            go.Bar(
                x=top_importances,
                y=top_features,
                orientation='h',
                marker_color=self.colors['secondary'],
                text=[f'{imp:.3f}' for imp in top_importances],
                textposition='auto'
            )
        ])
        
        fig.update_layout(
            title=f'🔧 Top {top_n} Feature Importances',
            xaxis_title='Importance',
            yaxis_title='Features',
            plot_bgcolor='white',
            height=600
        )
        
        return fig

