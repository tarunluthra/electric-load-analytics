def run_optimized_pipeline():
    """
    Run the complete optimized peak load prediction pipeline
    """
    print("🚀 STARTING OPTIMIZED PEAK LOAD PREDICTION PIPELINE")
    print("=" * 70)
    
    # Step 1: Load and process data
    print("\n📁 STEP 1: DATA LOADING & PROCESSING")
    print("-" * 40)
    
    # Load data
    datasets = processor.load_data()
    
    # Process weather data
    weather_agg = processor.process_weather_data()
    
    # Merge and create features
    full_data = processor.merge_data(weather_agg)
    
    # Get feature columns
    feature_cols = processor.get_feature_columns()
    print(f"✅ Features created: {len(feature_cols)}")
    
    # Step 2: Prepare training data
    print("\n🎯 STEP 2: MODEL TRAINING")
    print("-" * 30)
    
    # Prepare data for modeling
    model_data = full_data[feature_cols + ['Is_Peak']].dropna()
    X = model_data[feature_cols]
    y = model_data['Is_Peak']
    
    print(f"📊 Training data shape: {X.shape}")
    print(f"🎯 Peak hours: {y.sum()} ({y.mean()*100:.1f}%)")
    
    # Split data
    X_train, X_val, y_train, y_val = train_test_split(
        X, y, test_size=0.2, random_state=RANDOM_STATE, stratify=y
    )
    
    # Train models
    models, scores, best_model_name = trainer.train_ensemble_models(
        X_train, y_train, X_val, y_val
    )
    
    # Cross-validation
    cv_results = trainer.cross_validate(X, y)
    
    # Step 3: Generate predictions for 2008
    print("\n🔮 STEP 3: GENERATING 2008 PREDICTIONS")
    print("-" * 40)
    
    # Prepare 2008 data
    pred_2008 = processor.target_df.copy()
    pred_2008 = pred_2008.merge(weather_agg, on=['Date', 'Hour'], how='left')
    pred_2008 = processor.create_features(pred_2008)
    
    # Fill missing values
    for col in feature_cols:
        if col not in pred_2008.columns:
            pred_2008[col] = 0
        pred_2008[col] = pred_2008[col].fillna(0)
    
    # Generate predictions
    X_pred = pred_2008[feature_cols]
    probabilities = trainer.predict(X_pred)
    
    # Create output
    output_df = pred_2008[['Date', 'Hour']].copy()
    output_df['Daily Peak Probability'] = np.clip(probabilities, 0, 1)
    
    # Save results
    output_df.to_csv('probability_estimates_optimized.csv', index=False)
    
    print(f"✅ Predictions generated: {len(output_df):,} hours")
    print(f"📁 Saved to: probability_estimates_optimized.csv")
    print(f"🎯 Probability range: {output_df['Daily Peak Probability'].min():.4f} to {output_df['Daily Peak Probability'].max():.4f}")
    
    # Step 4: Create visualizations
    print("\n📊 STEP 4: CREATING VISUALIZATIONS")
    print("-" * 35)
    
    # Comprehensive dashboard
    dashboard = visualizer.create_comprehensive_dashboard(full_data, output_df)
    dashboard.show()
    
    # Model performance
    perf_plot = visualizer.plot_model_performance(scores)
    perf_plot.show()
    
    # Feature importance (if available)
    if hasattr(trainer.best_model, 'feature_importances_'):
        feat_plot = visualizer.plot_feature_importance(
            feature_cols, trainer.best_model.feature_importances_
        )
        feat_plot.show()
    
    # Step 5: Summary
    print("\n📋 STEP 5: SUMMARY")
    print("-" * 20)
    
    print(f"🏆 Best Model: {best_model_name}")
    print(f"📊 Brier Score: {scores[best_model_name]:.4f}")
    print(f"🔧 Features Used: {len(feature_cols)}")
    print(f"📈 Training Samples: {len(X_train):,}")
    print(f"🧪 Validation Samples: {len(X_val):,}")
    print(f"🔮 Predictions: {len(output_df):,}")
    
    # Daily probability sums
    daily_sums = output_df.groupby('Date')['Daily Peak Probability'].sum()
    print(f"📊 Daily probability sums - Min: {daily_sums.min():.4f}, Max: {daily_sums.max():.4f}, Mean: {daily_sums.mean():.4f}")
    
    print("\n✅ OPTIMIZED PIPELINE COMPLETED SUCCESSFULLY!")
    
    return {
        'models': models,
        'scores': scores,
        'best_model': best_model_name,
        'predictions': output_df,
        'full_data': full_data,
        'feature_cols': feature_cols
    }

# Run the optimized pipeline
results = run_optimized_pipeline()# =============================================================================
