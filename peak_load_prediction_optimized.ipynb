class PeakLoadModelTrainer:
    """
    Optimized model training class with ensemble methods
    """
    
    def __init__(self, random_state: int = 42):
        self.random_state = random_state
        self.models = {}
        self.scores = {}
        self.best_model = None
        self.best_model_name = None
        
    def train_ensemble_models(self, X_train, y_train, X_val, y_val) -> Tuple[Dict, Dict, str]:
        """
        Train multiple models with optimized hyperparameters
        """
        print("🎯 Training ensemble models...")
        
        # Model configurations
        model_configs = {
            'RandomForest': RandomForestClassifier(
                n_estimators=200,
                max_depth=15,
                min_samples_split=10,
                min_samples_leaf=5,
                random_state=self.random_state,
                n_jobs=-1
            ),
            'XGBoost': xgb.XGBClassifier(
                n_estimators=200,
                max_depth=8,
                learning_rate=0.1,
                subsample=0.8,
                colsample_bytree=0.8,
                random_state=self.random_state,
                eval_metric='logloss'
            ),
            'GradientBoosting': GradientBoostingClassifier(
                n_estimators=200,
                max_depth=8,
                learning_rate=0.1,
                subsample=0.8,
                random_state=self.random_state
            ),
            'LogisticRegression': LogisticRegression(
                C=1.0,
                max_iter=1000,
                random_state=self.random_state
            )
        }
        
        # Train individual models
        for name, model in model_configs.items():
            print(f"🌲 Training {name}...")
            model.fit(X_train, y_train)
            self.models[name] = model
            
            # Evaluate
            y_pred_proba = model.predict_proba(X_val)[:, 1]
            brier_score = brier_score_loss(y_val, y_pred_proba)
            self.scores[name] = brier_score
            print(f"   Brier Score: {brier_score:.4f}")
        
        # Create ensemble models
        print("🗳️ Creating ensemble models...")
        
        # Voting Ensemble
        voting_clf = VotingClassifier(
            estimators=list(model_configs.items()),
            voting='soft'
        )
        voting_clf.fit(X_train, y_train)
        self.models['VotingEnsemble'] = voting_clf
        
        y_pred_proba = voting_clf.predict_proba(X_val)[:, 1]
        brier_score = brier_score_loss(y_val, y_pred_proba)
        self.scores['VotingEnsemble'] = brier_score
        print(f"   Voting Ensemble Brier Score: {brier_score:.4f}")
        
        # Stacking Ensemble
        stacking_clf = StackingClassifier(
            estimators=list(model_configs.items())[:3],  # Use top 3 models
            final_estimator=LogisticRegression(),
            cv=5
        )
        stacking_clf.fit(X_train, y_train)
        self.models['StackingEnsemble'] = stacking_clf
        
        y_pred_proba = stacking_clf.predict_proba(X_val)[:, 1]
        brier_score = brier_score_loss(y_val, y_pred_proba)
        self.scores['StackingEnsemble'] = brier_score
        print(f"   Stacking Ensemble Brier Score: {brier_score:.4f}")
        
        # Find best model
        self.best_model_name = min(self.scores, key=self.scores.get)
        self.best_model = self.models[self.best_model_name]
        
        print(f"\n🏆 Best Model: {self.best_model_name} (Brier Score: {self.scores[self.best_model_name]:.4f})")
        
        return self.models, self.scores, self.best_model_name
    
    def cross_validate(self, X, y, cv_folds: int = 5) -> Dict:
        """
        Perform time series cross-validation
        """
        print(f"🧪 Performing {cv_folds}-fold time series cross-validation...")
        
        tscv = TimeSeriesSplit(n_splits=cv_folds)
        cv_results = {}
        
        for name, model in self.models.items():
            cv_scores = cross_val_score(
                model, X, y, 
                cv=tscv, 
                scoring='neg_brier_score',
                n_jobs=-1
            )
            cv_scores = -cv_scores  # Convert back to positive
            
            cv_results[name] = {
                'mean': cv_scores.mean(),
                'std': cv_scores.std(),
                'scores': cv_scores
            }
            
            print(f"   {name:20s}: {cv_scores.mean():.4f} ± {cv_scores.std():.4f}")
        
        return cv_results
    
    def predict(self, X) -> np.ndarray:
        """
        Make predictions using the best model
        """
        return self.best_model.predict_proba(X)[:, 1]

# Initialize trainer
trainer = PeakLoadModelTrainer(random_state=RANDOM_STATE)
