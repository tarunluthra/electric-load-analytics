class PeakLoadDataProcessor:
    """
    Optimized data processing class for peak load prediction
    """
    
    def __init__(self, data_path: str = "."):
        self.data_path = Path(data_path)
        self.weather_df = None
        self.load_df = None
        self.target_df = None
        self.full_data = None
        
    def load_data(self) -> Dict[str, pd.DataFrame]:
        """
        Load and validate all datasets with error handling
        """
        try:
            print("📁 Loading datasets...")
            
            # Load with optimized parameters
            self.weather_df = pd.read_csv(
                self.data_path / 'weather_data.csv',
                parse_dates=['Date'],
                dtype={'Station_ID': 'category', 'Temperature': 'float32'}
            )
            
            self.load_df = pd.read_csv(
                self.data_path / 'load_hist_data.csv',
                parse_dates=['Date'],
                dtype={'Load': 'float32'}
            )
            
            self.target_df = pd.read_csv(
                self.data_path / 'probability_estimates.csv',
                parse_dates=['Date']
            )
            
            # Validate data
            self._validate_data()
            
            print("✅ Data loaded successfully!")
            print(f"   Weather: {self.weather_df.shape}")
            print(f"   Load: {self.load_df.shape}")
            print(f"   Target: {self.target_df.shape}")
            
            return {
                'weather': self.weather_df,
                'load': self.load_df,
                'target': self.target_df
            }
            
        except Exception as e:
            print(f"❌ Error loading data: {e}")
            raise
    
    def _validate_data(self):
        """
        Validate data integrity
        """
        # Check for required columns
        required_cols = {
            'weather': ['Date', 'Hour', 'Station_ID', 'Temperature'],
            'load': ['Date', 'Hour', 'Load'],
            'target': ['Date', 'Hour', 'Daily Peak Probability']
        }
        
        for dataset, cols in required_cols.items():
            df = getattr(self, f'{dataset}_df')
            missing_cols = set(cols) - set(df.columns)
            if missing_cols:
                raise ValueError(f"Missing columns in {dataset}: {missing_cols}")
        
        # Check for missing values
        for dataset in ['weather', 'load', 'target']:
            df = getattr(self, f'{dataset}_df')
            missing_count = df.isnull().sum().sum()
            if missing_count > 0:
                print(f"⚠️  {dataset} has {missing_count} missing values")
    
    def process_weather_data(self) -> pd.DataFrame:
        """
        Optimized weather data processing with vectorized operations
        """
        print("🌡️ Processing weather data...")
        
        # Vectorized aggregation
        weather_agg = (self.weather_df
                      .groupby(['Date', 'Hour'], as_index=False)
                      .agg({
                          'Temperature': ['mean', 'std', 'min', 'max']
                      }))
        
        # Flatten column names
        weather_agg.columns = ['Date', 'Hour', 'Avg_Temperature', 'Temp_Std', 'Temp_Min', 'Temp_Max']
        
        # Fill missing values efficiently
        weather_agg['Temp_Std'] = weather_agg['Temp_Std'].fillna(0)
        
        print(f"✅ Weather data processed: {weather_agg.shape}")
        return weather_agg

# Initialize processor
processor = PeakLoadDataProcessor()
print("🏗️ Data processor initialized")# =============================================================================
