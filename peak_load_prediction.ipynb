        "                                              6: 'Summer', 7: 'Summer', 8: 'Summer',\n",
        "                                              9: 'Fall', 10: 'Fall', 11: 'Fall'})\n",
        "seasonal_probs = pred_2008.groupby('Season')['Daily Peak Probability'].mean()\n",
        "season_order = ['Winter', 'Spring', 'Summer', 'Fall']\n",
        "seasonal_probs = seasonal_probs.reindex(season_order)\n",
        "axes[0, 1].bar(range(4), seasonal_probs.values, alpha=0.7, color=['lightblue', 'lightgreen', 'orange', 'brown'])\n",
