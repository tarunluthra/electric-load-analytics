      "source": [
        "# Extract temporal features\n",
        "full_data['Year'] = full_data['Date'].dt.year\n",
        "full_data['Month'] = full_data['Date'].dt.month\n",
        "full_data['Day'] = full_data['Date'].dt.day\n",
        "full_data['DayOfWeek'] = full_data['Date'].dt.dayofweek  # 0=Monday, 6=Sunday\n",
        "full_data['DayOfYear'] = full_data['Date'].dt.dayofyear\n",
        "full_data['IsWeekend'] = (full_data['DayOfWeek'] >= 5).astype(int)\n",
        "\n",
        "# Create hour-based features\n",
        "full_data['Hour_Sin'] = np.sin(2 * np.pi * full_data['Hour'] / 24)\n",
        "full_data['Hour_Cos'] = np.cos(2 * np.pi * full_data['Hour'] / 24)\n",
        "\n",
        "# Create temperature-based features\n",
        "full_data['Temp_Squared'] = full_data['Avg_Temperature'] ** 2\n",
        "full_data['Temp_Cubed'] = full_data['Avg_Temperature'] ** 3\n",
        "\n",
        "# Rolling temperature features (previous day same hour)\n",
        "full_data = full_data.sort_values(['Date', 'Hour'])\n",
        "full_data['Prev_Day_Temp'] = full_data.groupby('Hour')['Avg_Temperature'].shift(1)\n",
        "full_data['Prev_Day_Load'] = full_data.groupby('Hour')['Load'].shift(1)\n",
        "\n",
        "# Temperature difference from previous day\n",
        "full_data['Temp_Diff'] = full_data['Avg_Temperature'] - full_data['Prev_Day_Temp']\n",
        "\n",
        "print(\"Feature engineering completed. New features:\")\n",
        "print([col for col in full_data.columns if col not in ['Date', 'Hour', 'Load', 'Avg_Temperature', 'Is_Peak', 'DateTime']])\n"
      ]
