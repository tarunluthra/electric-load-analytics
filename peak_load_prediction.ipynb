      "source": [
        "# Create a detailed analysis of the U-shaped temperature-load relationship\n",
        "print(\"=== U-SHAPED LOAD vs TEMPERATURE ANALYSIS ===\")\n",
        "\n",
        "# Load and merge data for analysis\n",
        "weather_df = pd.read_csv('weather_data.csv')\n",
        "load_df = pd.read_csv('load_hist_data.csv')\n",
        "\n",
        "# Convert dates\n",
        "weather_df['Date'] = pd.to_datetime(weather_df['Date'])\n",
        "load_df['Date'] = pd.to_datetime(load_df['Date'])\n",
        "\n",
        "# Aggregate weather data\n",
        "weather_agg = weather_df.groupby(['Date', 'Hour'])['Temperature'].mean().reset_index()\n",
        "weather_agg.columns = ['Date', 'Hour', 'Avg_Temperature']\n",
        "\n",
        "# Merge with load data\n",
        "merged_data = pd.merge(load_df, weather_agg, on=['Date', 'Hour'], how='inner')\n",
        "\n",
        "print(f\"Analysis based on {len(merged_data):,} data points\")\n",
        "\n",
        "# Analyze the U-shaped relationship\n",
        "print(f\"\\n1. TEMPERATURE RANGES AND LOAD PATTERNS:\")\n",
        "\n",
        "# Define temperature ranges\n",
        "temp_ranges = [\n",
        "    (\"Very Cold\", merged_data['Avg_Temperature'] < 30),\n",
        "    (\"Cold\", (merged_data['Avg_Temperature'] >= 30) & (merged_data['Avg_Temperature'] < 50)),\n",
        "    (\"Mild\", (merged_data['Avg_Temperature'] >= 50) & (merged_data['Avg_Temperature'] < 70)),\n",
        "    (\"Warm\", (merged_data['Avg_Temperature'] >= 70) & (merged_data['Avg_Temperature'] < 85)),\n",
        "    (\"Hot\", merged_data['Avg_Temperature'] >= 85)\n",
        "]\n",
        "\n",
        "for range_name, condition in temp_ranges:\n",
        "    subset = merged_data[condition]\n",
        "    if len(subset) > 0:\n",
        "        avg_load = subset['Load'].mean()\n",
        "        avg_temp = subset['Avg_Temperature'].mean()\n",
        "        count = len(subset)\n",
        "        print(f\"   {range_name:10} (<{30 if range_name=='Very Cold' else 50 if range_name=='Cold' else 70 if range_name=='Mild' else 85 if range_name=='Warm' else '∞'}°F): \"\n",
        "              f\"Avg Load = {avg_load:.0f} MW, Avg Temp = {avg_temp:.1f}°F, Count = {count:,}\")\n",
        "\n",
        "# Find the optimal temperature range (minimum load)\n",
        "print(f\"\\n2. OPTIMAL TEMPERATURE ANALYSIS:\")\n",
        "# Group by temperature bins to find minimum load\n",
        "temp_bins = pd.cut(merged_data['Avg_Temperature'], bins=20)\n",
        "load_by_temp = merged_data.groupby(temp_bins)['Load'].agg(['mean', 'count']).reset_index()\n",
        "load_by_temp = load_by_temp[load_by_temp['count'] > 100]  # Only bins with sufficient data\n",
        "\n",
        "min_load_idx = load_by_temp['mean'].idxmin()\n",
        "optimal_temp_range = load_by_temp.loc[min_load_idx]\n",
        "print(f\"   Minimum average load: {optimal_temp_range['mean']:.0f} MW\")\n",
        "print(f\"   Optimal temperature range: {optimal_temp_range['Avg_Temperature']}\")\n",
        "print(f\"   Data points in optimal range: {optimal_temp_range['count']:,}\")\n",
        "\n",
        "# Analyze load increase at extremes\n",
        "print(f\"\\n3. LOAD INCREASE AT TEMPERATURE EXTREMES:\")\n",
        "\n",
        "# Very cold vs optimal\n",
        "very_cold = merged_data[merged_data['Avg_Temperature'] < 30]\n",
        "optimal = merged_data[(merged_data['Avg_Temperature'] >= 60) & (merged_data['Avg_Temperature'] <= 70)]\n",
        "if len(very_cold) > 0 and len(optimal) > 0:\n",
        "    cold_increase = (very_cold['Load'].mean() - optimal['Load'].mean()) / optimal['Load'].mean() * 100\n",
        "    print(f\"   Load increase in very cold weather: +{cold_increase:.1f}%\")\n",
        "\n",
        "# Very hot vs optimal\n",
        "very_hot = merged_data[merged_data['Avg_Temperature'] > 85]\n",
        "if len(very_hot) > 0 and len(optimal) > 0:\n",
        "    hot_increase = (very_hot['Load'].mean() - optimal['Load'].mean()) / optimal['Load'].mean() * 100\n",
        "    print(f\"   Load increase in very hot weather: +{hot_increase:.1f}%\")\n",
        "\n",
        "# Seasonal analysis\n",
        "print(f\"\\n4. SEASONAL PATTERNS:\")\n",
        "merged_data['Month'] = merged_data['Date'].dt.month\n",
        "merged_data['Season'] = merged_data['Month'].map({\n",
        "    12: 'Winter', 1: 'Winter', 2: 'Winter',\n",
        "    3: 'Spring', 4: 'Spring', 5: 'Spring',\n",
        "    6: 'Summer', 7: 'Summer', 8: 'Summer',\n",
        "    9: 'Fall', 10: 'Fall', 11: 'Fall'\n",
        "})\n",
        "\n",
        "seasonal_analysis = merged_data.groupby('Season').agg({\n",
        "    'Load': 'mean',\n",
        "    'Avg_Temperature': 'mean'\n",
