        "\n",
        "# Solution 1: Probability normalization\n",
        "def normalize_daily_probabilities(predictions_df):\n",
        "    \"\"\"\n",
        "    Normalize probabilities so each day sums to 1.0\n",
        "    \"\"\"\n",
        "    # Group by date and normalize probabilities\n",
        "    daily_sums = predictions_df.groupby('Date')['Daily_Peak_Probability'].sum()\n",
        "    \n",
        "    # Create normalized probabilities\n",
        "    predictions_df['Normalized_Probability'] = predictions_df.apply(\n",
        "        lambda row: row['Daily_Peak_Probability'] / daily_sums[row['Date']], axis=1\n",
        "    )\n",
        "    \n",
        "    return predictions_df\n",
        "\n",
        "# Solution 2: Temperature-based calibration\n",
        "def calibrate_probabilities(predictions_df, temperature_factor=0.8):\n",
        "    \"\"\"\n",
        "    Apply temperature-based calibration to reduce overconfidence\n",
        "    \"\"\"\n",
        "    # Reduce probabilities during extreme temperatures (when model is less certain)\n",
        "    predictions_df['Calibrated_Probability'] = predictions_df['Daily_Peak_Probability'] * temperature_factor\n",
        "    \n",
        "    # Normalize after calibration\n",
        "    daily_sums = predictions_df.groupby('Date')['Calibrated_Probability'].sum()\n",
        "    predictions_df['Calibrated_Probability'] = predictions_df.apply(\n",
        "        lambda row: row['Calibrated_Probability'] / daily_sums[row['Date']], axis=1\n",
        "    )\n",
        "    \n",
