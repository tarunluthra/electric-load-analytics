      "source": [
        "# Define major US holidays (simplified list)\n",
        "def get_us_holidays(year):\n",
        "    holidays = []\n",
        "    \n",
        "    # New Year's Day\n",
        "    holidays.append(f\"{year}-01-01\")\n",
        "    \n",
        "    # Martin Luther King Jr. Day (third Monday in January)\n",
        "    mlk_day = pd.Timestamp(f\"{year}-01-15\") + pd.Timedelta(days=(0 - pd.Timestamp(f\"{year}-01-15\").dayofweek) % 7)\n",
        "    holidays.append(mlk_day.strftime(\"%Y-%m-%d\"))\n",
        "    \n",
        "    # Presidents' Day (third Monday in February)\n",
        "    pres_day = pd.Timestamp(f\"{year}-02-15\") + pd.Timedelta(days=(0 - pd.Timestamp(f\"{year}-02-15\").dayofweek) % 7)\n",
        "    holidays.append(pres_day.strftime(\"%Y-%m-%d\"))\n",
        "    \n",
        "    # Memorial Day (last Monday in May)\n",
        "    memorial_day = pd.Timestamp(f\"{year}-05-31\") - pd.Timedelta(days=(pd.Timestamp(f\"{year}-05-31\").dayofweek + 1) % 7)\n",
        "    holidays.append(memorial_day.strftime(\"%Y-%m-%d\"))\n",
        "    \n",
        "    # Independence Day\n",
        "    holidays.append(f\"{year}-07-04\")\n",
        "    \n",
        "    # Labor Day (first Monday in September)\n",
        "    labor_day = pd.Timestamp(f\"{year}-09-01\") + pd.Timedelta(days=(0 - pd.Timestamp(f\"{year}-09-01\").dayofweek) % 7)\n",
        "    holidays.append(labor_day.strftime(\"%Y-%m-%d\"))\n",
        "    \n",
        "    # Columbus Day (second Monday in October)\n",
        "    columbus_day = pd.Timestamp(f\"{year}-10-08\") + pd.Timedelta(days=(0 - pd.Timestamp(f\"{year}-10-08\").dayofweek) % 7)\n",
        "    holidays.append(columbus_day.strftime(\"%Y-%m-%d\"))\n",
        "    \n",
        "    # Veterans Day\n",
        "    holidays.append(f\"{year}-11-11\")\n",
        "    \n",
        "    # Thanksgiving (fourth Thursday in November)\n",
        "    thanksgiving = pd.Timestamp(f\"{year}-11-22\") + pd.Timedelta(days=(3 - pd.Timestamp(f\"{year}-11-22\").dayofweek) % 7)\n",
        "    holidays.append(thanksgiving.strftime(\"%Y-%m-%d\"))\n",
        "    \n",
        "    # Christmas Day\n",
        "    holidays.append(f\"{year}-12-25\")\n",
        "    \n",
        "    return [pd.Timestamp(h) for h in holidays]\n",
        "\n",
        "# Add holiday information for all years in the dataset\n",
        "all_holidays = []\n",
        "for year in range(2005, 2009):\n",
        "    all_holidays.extend(get_us_holidays(year))\n",
        "\n",
        "# Add holiday flag to the dataset\n",
        "full_data['IsHoliday'] = full_data['Date'].isin(all_holidays).astype(int)\n",
        "\n",
        "print(f\"Total holidays identified: {len(all_holidays)}\")\n",
        "print(f\"Holiday days in dataset: {full_data['IsHoliday'].sum()}\")\n"
