def create_validation_framework(X, y, models, feature_cols):
    """
    Create a comprehensive validation framework for model evaluation
    """
    
    print("🧪 CREATING VALIDATION FRAMEWORK")
    print("=" * 40)
    
    from sklearn.model_selection import TimeSeriesSplit, cross_val_score
    from sklearn.metrics import brier_score_loss, log_loss, roc_auc_score, precision_recall_curve
    
    # 1. TIME SERIES CROSS-VALIDATION
    print("\n📅 TIME SERIES CROSS-VALIDATION:")
    print("-" * 35)
    
    tscv = TimeSeriesSplit(n_splits=5)
    
    validation_results = {}
    
    for name, model in models.items():
        print(f"\n🔍 Validating {name}...")
        
        # Time series CV scores
        cv_scores = cross_val_score(model, X, y, cv=tscv, scoring='neg_brier_score')
        cv_scores = -cv_scores  # Convert back to positive Brier scores
        
        validation_results[name] = {
            'cv_mean': cv_scores.mean(),
            'cv_std': cv_scores.std(),
            'cv_scores': cv_scores
        }
        
        print(f"  CV Brier Score: {cv_scores.mean():.4f} ± {cv_scores.std():.4f}")
        print(f"  CV Range: [{cv_scores.min():.4f}, {cv_scores.max():.4f}]")
    
    # 2. MODEL CALIBRATION ANALYSIS
    print("\n🎯 MODEL CALIBRATION ANALYSIS:")
    print("-" * 35)
    
    # Split data for calibration analysis
    X_train_cal, X_test_cal, y_train_cal, y_test_cal = train_test_split(
        X, y, test_size=0.3, random_state=42, stratify=y
    )
    
    calibration_results = {}
    
    for name, model in models.items():
        # Train model
        model.fit(X_train_cal, y_train_cal)
        
        # Get predictions
        y_pred_proba = model.predict_proba(X_test_cal)[:, 1]
        
        # Calculate calibration metrics
        brier_score = brier_score_loss(y_test_cal, y_pred_proba)
        log_loss_score = log_loss(y_test_cal, y_pred_proba)
        
        try:
            roc_auc = roc_auc_score(y_test_cal, y_pred_proba)
        except:
            roc_auc = 0.5  # Default for perfect calibration
        
        calibration_results[name] = {
            'brier_score': brier_score,
            'log_loss': log_loss_score,
            'roc_auc': roc_auc,
            'predictions': y_pred_proba,
            'actuals': y_test_cal
        }
        
        print(f"{name:20s}: Brier={brier_score:.4f}, LogLoss={log_loss_score:.4f}, ROC-AUC={roc_auc:.4f}")
    
    # 3. FEATURE IMPORTANCE ANALYSIS
    print("\n🔧 FEATURE IMPORTANCE ANALYSIS:")
    print("-" * 35)
    
    feature_importance_results = {}
    
    for name, model in models.items():
        if hasattr(model, 'feature_importances_'):
            importance_df = pd.DataFrame({
                'feature': feature_cols,
                'importance': model.feature_importances_
            }).sort_values('importance', ascending=False)
            
            feature_importance_results[name] = importance_df
            
            print(f"\n{name} - Top 5 Features:")
            for _, row in importance_df.head(5).iterrows():
                print(f"  {row['feature']:25s}: {row['importance']:.3f}")
    
    # 4. PREDICTION CONFIDENCE ANALYSIS
    print("\n🎲 PREDICTION CONFIDENCE ANALYSIS:")
    print("-" * 40)
    
    confidence_results = {}
    
    for name, model in models.items():
        y_pred_proba = calibration_results[name]['predictions']
        y_actual = calibration_results[name]['actuals']
        
        # Confidence bins
        confidence_bins = pd.cut(y_pred_proba, bins=10)
        confidence_analysis = pd.DataFrame({
            'predicted_prob': y_pred_proba,
            'actual': y_actual,
            'bin': confidence_bins
        })
        
        bin_stats = confidence_analysis.groupby('bin').agg({
            'predicted_prob': ['mean', 'count'],
            'actual': 'mean'
        })
        
        confidence_results[name] = bin_stats
        
        print(f"\n{name} - Confidence Calibration:")
        for i, (bin_range, row) in enumerate(bin_stats.iterrows()):
            pred_mean = row[('predicted_prob', 'mean')]
            actual_mean = row[('actual', 'mean')]
            count = row[('predicted_prob', 'count')]
            print(f"  {bin_range}: Pred={pred_mean:.3f}, Actual={actual_mean:.3f}, Count={count}")
    
    return {
        'validation_results': validation_results,
        'calibration_results': calibration_results,
        'feature_importance_results': feature_importance_results,
        'confidence_results': confidence_results
    }

