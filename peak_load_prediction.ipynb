        "historical_hourly_prob = full_data.groupby('Hour')['Is_Peak'].mean()\n",
        "predicted_hourly_prob = pred_2008.groupby('Hour')['Daily Peak Probability'].mean()\n",
        "axes[1, 0].plot(range(1, 25), historical_hourly_prob.values, marker='o', label='Historical', linewidth=2)\n",
