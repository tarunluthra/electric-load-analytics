        "                '2008-07-04', '2008-09-01', '2008-10-13', '2008-11-11',\n",
        "                '2008-11-27', '2008-12-25'\n",
        "            ]\n",
        "            pred_2008[feature] = pred_2008['Date'].astype(str).isin(holidays_2008).astype(int)\n",
        "        elif feature == 'Hour_Sin':\n",
        "            pred_2008[feature] = np.sin(2 * np.pi * pred_2008['Hour'] / 24)\n",
        "        elif feature == 'Hour_Cos':\n",
        "            pred_2008[feature] = np.cos(2 * np.pi * pred_2008['Hour'] / 24)\n",
        "        elif feature == 'Temp_Squared':\n",
        "            pred_2008[feature] = pred_2008['Avg_Temperature'] ** 2\n",
        "        elif feature == 'Temp_Cubed':\n",
        "            pred_2008[feature] = pred_2008['Avg_Temperature'] ** 3\n",
        "        elif feature == 'Prev_Day_Temp':\n",
        "            pred_2008[feature] = pred_2008['Avg_Temperature']  # Use current temp as fallback\n",
        "        elif feature == 'Prev_Day_Load':\n",
        "            pred_2008[feature] = 1000  # Default load value\n",
        "        elif feature == 'Temp_Diff':\n",
        "            pred_2008[feature] = 0  # No difference\n",
        "        else:\n",
        "            pred_2008[feature] = 0  # Default value for other features\n",
        "\n",
        "print(f\"Final feature check - All required features present: {all(col in pred_2008.columns for col in feature_cols)}\")\n",
        "print(f\"Available columns: {len(pred_2008.columns)}\")\n",
        "\n",
        "# Generate predictions using the best model\n",
        "X_pred = pred_2008[feature_cols]\n",
        "\n",
        "if best_model_name == 'Logistic Regression':\n",
        "    model, scaler = trained_models[best_model_name]\n",
        "    X_pred_scaled = scaler.transform(X_pred)\n",
        "    probabilities = model.predict_proba(X_pred_scaled)[:, 1]\n",
        "else:\n",
        "    model = trained_models[best_model_name]\n",
        "    probabilities = model.predict_proba(X_pred)[:, 1]\n",
        "\n",
        "# Add probabilities to the prediction dataframe\n",
        "pred_2008['Daily Peak Probability'] = probabilities\n",
        "\n",
